# gRPC listen port
SERVER_PORT=50051

# HTTP/REST (grpc-gateway) listen port
HTTP_PORT=8080

# Logging: json | text
LOG_FORMAT=json
LOG_LEVEL=info

# OpenTelemetry: pretty-print spans to stdout when true
OTEL_ENABLED=false

# Ingestion limits
MAX_DOCUMENT_BYTES=33554432
MAX_DOCUMENT_PAGES=200

# OCR language hint; only effective in a build with the "tesseract" tag
OCR_LANGUAGES=eng

# Attempt OCR by default when a request omits options
OCR_DEFAULT=false

# Power BI service principal (leave empty to disable publishing)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=

# Optional: default workspace (group) id; empty = "My workspace"
POWERBI_WORKSPACE_ID=
# Vision-LLM refinement (optional; tableextract refine skips without it)
NVIDIA_API_KEY=
LLM_API_KEY=

# OpenCV table-extraction endpoint (/v1/table-extract)
TABLEEXTRACT_PYTHON=python3
TABLEEXTRACT_DIR=tableextract

